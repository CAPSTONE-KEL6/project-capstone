# Salin menjadi .env lalu isi (atau set sebagai environment variable). Aplikasi tidak membaca .env otomatis:
# jalankan dengan:  node --env-file=.env server.js   (Node 20.6+)
PORT=3000
NODE_ENV=production
DATA_DIR=./data
# Akun admin pertama (dibuat sekali, saat basis data masih kosong). Bila kosong, password acak dicetak di konsol.
ADMIN_EMAIL=admin@perusahaan.co.id
ADMIN_PASSWORD=
# URL publik situs (dipakai pada email konfirmasi)
PUBLIC_URL=https://www.contoh.co.id
# Jika di belakang proxy/HTTPS (Nginx, Cloudflare, dsb.)
TRUST_PROXY=1
# Email (SMTP). Jika SMTP_HOST kosong, email hanya dicatat di tabel outbox dan tidak dikirim.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PT Indo Buana Berkah <noreply@perusahaan.co.id>"
# Alamat yang diberi notifikasi tiap ada inquiry baru (opsional)
ADMIN_NOTIFY=
